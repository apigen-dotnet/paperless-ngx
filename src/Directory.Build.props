<Project>
  <PropertyGroup>
    <Authors>Frank Hommers</Authors>
    <Company>Initialize.nl</Company>
    <Copyright>Copyright (c) Frank Hommers / Initialize.nl</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/apigen-dotnet/paperless-ngx</PackageProjectUrl>
    <RepositoryUrl>https://github.com/apigen-dotnet/paperless-ngx</RepositoryUrl>
  </PropertyGroup>

  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'Apigen.PaperlessNgx.Models'">
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'Apigen.PaperlessNgx.Client'">
    <PackageId>Apigen.PaperlessNgx.Client</PackageId>
    <Version>2.20.1</Version>
    <Description>Generated C# client for the Paperless-ngx document management API</Description>
    <PackageTags>paperless-ngx;api;client;openapi;apigen;documents</PackageTags>
    <PackageReadmeFile>NUGET.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup Condition="'$(MSBuildProjectName)' == 'Apigen.PaperlessNgx.Client'">
    <None Include="../../NUGET.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
